# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# moscow open-data raw dumps (keep only *.min.json.gz + meta in git if desired)
data/moscow/*.json
data/moscow/*.jsonl
data/moscow/*.checkpoint.json
!data/moscow/meta.json
!data/moscow/*.min.json.gz
!data/moscow/.gitkeep

# Reform GKH / ФРТ dumps (large CSV; re-download via scripts/download-reform-gkh.py)
data/reform-gkh/raw/
data/reform-gkh/extracted/
data/reform-gkh/*.html
data/reform-gkh/cookies.txt
data/reform-gkh/_parse_*.py
!data/reform-gkh/README.md
!data/reform-gkh/.gitkeep
!data/reform-gkh/index/
!data/reform-gkh/index/*.min.json.gz

# GIS ЖКХ nationwide MKD (raw ~450MB CSV; rebuild via scripts/build-gis-gkh-index.py)
data/gis-gkh/raw/
data/gis-gkh/extracted/
data/gis-gkh/*.html
data/gis-gkh/index/*.sqlite
data/gis-gkh/index/*.jsonl.gz
!data/gis-gkh/README.md
!data/gis-gkh/index/
!data/gis-gkh/index/mkd.min.sqlite.gz

# Electricity tariffs (scraped regional rates; keep index, ignore raw HTML)
data/electricity-tariffs/raw/
!data/electricity-tariffs/README.md
!data/electricity-tariffs/index/
!data/electricity-tariffs/index/regions.min.json

# typescript
*.tsbuildinfo
next-env.d.ts

# local secrets dump — never commit
ключи.xlsx
*.xlsx
