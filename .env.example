# Google Gemini API key for panel photo analysis (optional)
# Create key: https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Telegram bot token from @BotFather → /mybots → your bot → API Token
# Required for saving user panels/requests and browser Telegram Login
BOT_TOKEN=

# Telegram bot username without @ — for Login Widget in browser
# Set domain in @BotFather → /setdomain for your site (e.g. elektropasport.vercel.app)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Optional separate secret for browser session tokens (defaults to BOT_TOKEN)
# AUTH_SECRET=

# Neon Postgres connection string (https://console.neon.tech → Connection string)
# Example: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Your numeric Telegram user id (get from @userinfobot) — where new leads are sent
TELEGRAM_ADMIN_CHAT_ID=

# Optional secret for Telegram webhook header verification
TELEGRAM_WEBHOOK_SECRET=

# One-time key to call /api/telegram/setup-webhook?key=...
TELEGRAM_SETUP_KEY=
