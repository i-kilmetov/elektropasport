# Qwen VL (DashScope / Alibaba Cloud Model Studio) — panel photo analysis
# 1) Console region: Singapore
# 2) Create API key: https://www.alibabacloud.com/help/en/model-studio/get-api-key
# 3) Activate model qwen3-vl-plus
# Endpoint is used by the server automatically (no UI field):
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# Optional overrides:
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_VL_MODEL=qwen3-vl-plus

# Open Icecat — free worldwide product datasheets (specs + PDF manuals).
# Register: https://icecat.biz/registration
# ICECAT_USERNAME = логин из профиля
# ICECAT_PASSWORD = пароль входа на icecat.biz (нужен для выгрузки каталога brands/models)
# Токены опциональны для Live JSON:
# ICECAT_USERNAME=
# ICECAT_PASSWORD=
# ICECAT_API_TOKEN=
# ICECAT_CONTENT_TOKEN=
#
# После деплоя синхронизируйте Open-каталог техники в БД (раз в день/неделю):
#   curl -X POST "https://www.tokom.ru/api/appliances/icecat/sync" \
#     -H "x-setup-key: $TELEGRAM_SETUP_KEY"
#
# Каталог модульных приборов IEK (публичная инфобаза, без ключа IEK):
#   curl -X POST "https://www.tokom.ru/api/catalog/iek/sync" \
#     -H "x-setup-key: $TELEGRAM_SETUP_KEY"
#
# Health check Live API:
#   https://www.tokom.ru/api/appliances/enrich/status

# EPREL (EU energy-label registry) — usually unavailable for RU entities.
# Kept optional; public web links still work without a key.
# Request (EU): https://eprel.ec.europa.eu/screen/requestpublicapikey
# EPREL_API_KEY=

# Public site URL (custom domain). Used for OAuth redirects, webhooks, payments.
NEXT_PUBLIC_APP_URL=https://tokom.ru

# Yandex Metrika counter id (public — visible in page HTML, safe to expose).
# Create at https://metrika.yandex.ru → Add counter → copy numeric id.
# NEXT_PUBLIC_YM_ID=12345678

# Google Analytics 4 measurement id (public — format G-XXXXXXXXXX).
# Create at https://analytics.google.com → Admin → Data streams → Web.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Staging subdomain test.tokom.ru — shared password gate, then Telegram login.
# Same product UI as tokom.ru, but separate accounts/sessions/data.
# Add test.tokom.ru in Vercel Domains (same project as tokom.ru).
# Optional: also add www.test.tokom.ru so HTTPS works before middleware redirects to test.tokom.ru.
TEST_SITE_PASSWORD=

# Telegram bot token from @BotFather → /mybots → your bot → API Token
# Required for saving user panels/requests and browser Telegram Login
BOT_TOKEN=

# Telegram bot username without @ (optional display / Mini App links)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Mini App short name from @BotFather (optional). Used in share links:
# https://t.me/<bot>/<app>?startapp=...
# NEXT_PUBLIC_TELEGRAM_MINI_APP_NAME=

# Browser login via Telegram OAuth QR (oauth.telegram.org).
# In @BotFather → your bot → Login Widget / Web Login:
#   - Allowed URL / domain: https://tokom.ru
#   - Redirect URI: https://tokom.ru/auth/telegram/callback
# Client ID is usually the numeric bot id (part of BOT_TOKEN before ':').
# Client Secret is required for the modern OIDC flow (recommended).
# TELEGRAM_CLIENT_ID=
# TELEGRAM_CLIENT_SECRET=

# Optional separate secret for browser session tokens (defaults to BOT_TOKEN)
# AUTH_SECRET=

# Neon Postgres connection string (https://console.neon.tech → Connection string)
# Example: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Legacy fallback if RU_DATABASE_URL is not set:
DATABASE_URL=

# Russian Postgres for personal data (152-FZ). Recommended: Amvera Cloud managed PostgreSQL.
# See docs/RU-DATABASE.md
RU_DATABASE_URL=

# Operator details for legal pages (self-employed)
OPERATOR_INN=
OPERATOR_EMAIL=support@tokom.ru

# Optional Web Push overrides. If unset, VAPID keys are generated once and
# stored in the database so Home Screen iPhone apps can receive notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@tokom.ru

# Your numeric Telegram user id (get from @userinfobot) — where new leads are sent
TELEGRAM_ADMIN_CHAT_ID=

# Optional secret for Telegram webhook header verification
TELEGRAM_WEBHOOK_SECRET=

# One-time key to call /api/telegram/setup-webhook?key=...
TELEGRAM_SETUP_KEY=

# DaData Suggestions API token (https://dadata.ru/api/suggest/address/)
# Used for street/house autocomplete in the lead flow. Keep server-only.
DADATA_API_KEY=

# Moscow open data API key (https://data.mos.ru/developers — личный кабинет)
# Used for Moscow address suggestions, building year, and capital-repair schedule.
MOS_DATA_API_KEY=
# Optional: dataset id if auto-discovery picks the wrong table or times out
# MOS_DOM_PASSPORT_DATASET_ID=60562
# Optional: HTTPS proxy inside Russia when apidata.mos.ru blocks Vercel IPs
# MOS_DATA_HTTPS_PROXY=http://user:pass@host:port

# YooKassa (https://yookassa.ru/platezhi-dlya-samozanyatyh/)
# Works for self-employed without ИП. Shop ID + secret key from the cabinet.
# After connecting, add HTTP-notification URL:
#   https://<your-domain>/api/payments/yookassa-notify
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional return URL after SBP (defaults to the Telegram Mini App or production site)
# YOOKASSA_RETURN_URL=

# Hidden research survey → Google Sheets (service account; Apps Script webhooks
# from Vercel are often blocked with an HTML interstitial).
# 1. Google Cloud → enable Google Sheets API → create a service account → JSON key
# 2. Share the sheet with the service account email as Editor (notify off)
# 3. Vercel Production: GOOGLE_SHEETS_ID + GOOGLE_SERVICE_ACCOUNT_JSON, then Redeploy
# 4. Check https://tokom.ru/api/research-survey → {"backend":"service-account"}
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_TAB=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Legacy Apps Script web app (unreliable from Vercel):
# GOOGLE_SHEETS_WEBHOOK_URL=
# GOOGLE_SHEETS_WEBHOOK_SECRET=
